JWT_SECRET=<generate-a-strong-shared-secret>
APP_URL=http://localhost:3000
PORT=8000
IDENTITY_SERVICE_URL=http://localhost:8080
ACADEMIC_SERVICE_URL=http://localhost:8081
BILLING_SERVICE_URL=http://localhost:8082
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_USERNAME=default
REDIS_TLS=false
REDIS_DB=0
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_PUBLIC_REQUESTS=60
RATE_LIMIT_PROTECTED_REQUESTS=120
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_REGISTER_REQUESTS=10
RATE_LIMIT_WEBHOOK_REQUESTS=120
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60

# Proxy resilience. PROXY_UPSTREAM_TIMEOUT_SECONDS bounds one proxied request
# end to end; a downstream that stops responding is answered with 504 "Upstream
# service timed out" and one that refuses the connection with 502 "Upstream
# service is unavailable", both as JSON envelopes. The default clears the
# slowest legitimate downstream call (tenant location geocoding).
PROXY_UPSTREAM_TIMEOUT_SECONDS=30
# PROXY_MAX_BODY_BYTES bounds a request body. A body over the limit is answered
# with 413 and never forwarded. The default is larger than every current payload,
# including the Duitku callback and the registration forms.
PROXY_MAX_BODY_BYTES=1048576

# HTTP server limits, in seconds. SERVER_WRITE_TIMEOUT_SECONDS must be greater
# than PROXY_UPSTREAM_TIMEOUT_SECONDS, otherwise the server would cut a response
# the proxy is still waiting for; startup fails with a configuration error if it
# is not.
SERVER_READ_HEADER_TIMEOUT_SECONDS=5
SERVER_READ_TIMEOUT_SECONDS=30
SERVER_WRITE_TIMEOUT_SECONDS=60
SERVER_IDLE_TIMEOUT_SECONDS=120
